# Copy to .env.local. Every variable is validated by packages/config/env.ts.
APP_ENV=local
# GIT_SHA is reported by /api/health; on Vercel it falls back to VERCEL_GIT_COMMIT_SHA (set by Vercel, never by hand).
# GIT_SHA=
# Local Supabase (pnpm db:start). Copy the keys from the `supabase start` output or `pnpm exec supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<from `supabase status`>
SUPABASE_SERVICE_ROLE_KEY=<from `supabase status`>
# Direct Postgres URL for the API repositories. Use the api_app login role (never postgres: it bypasses RLS). Local password: supabase/roles.sql.
DATABASE_URL=postgresql://api_app:api_app_local_only@127.0.0.1:54322/postgres
# Optional until M6 (AI) and M7 (Paymob); required when APP_ENV=production.
# AI_PROVIDER=anthropic
# AI_MODEL_ANALYZE=<cheap model for local>
# AI_API_KEY=<your dev key>
PAYMOB_MODE=sandbox
# PAYMOB_API_KEY=<sandbox key>
# Google sign-in (off locally; set per environment and enable in supabase/config.toml)
# AUTH_GOOGLE_ENABLED=false
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Observability: optional locally (reporting is off without them); required when APP_ENV=production (ADR-025).
# SENTRY_DSN=
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# Phone verification (issue #26). Secret of the keyed hash that stores phones and IPs: min 32 chars, one per environment,
# never rotated without a plan (old hashes would stop matching). Generate: openssl rand -base64 32. This value is local only.
PHONE_HASH_SECRET=local-dev-phone-hash-secret-0123456789abcdef
# Comma list of E.164 test numbers the API accepts outside production (default: +201000000001 to +201000000010). Refused in production.
# PHONE_TEST_NUMBERS=
# Account deletion (issue #27): lets the API erase the person at PostHog. Optional, both or neither.
# Create a personal API key in PostHog (free tier) with the person:write scope; the project id is in the project URL.
# Without them deletion still works and logs one warning. Required before the beta (M8).
# POSTHOG_PERSONAL_API_KEY=
# POSTHOG_PROJECT_ID=
