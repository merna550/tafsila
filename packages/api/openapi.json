{
  "openapi": "3.1.0",
  "info": {
    "title": "Tafsila API",
    "version": "1"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness check with build information",
        "responses": {
          "200": {
            "description": "The API is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ],
                      "example": "ok"
                    },
                    "environment": {
                      "type": "string",
                      "example": "staging"
                    },
                    "version": {
                      "type": "string",
                      "example": "1.2.3"
                    },
                    "gitSha": {
                      "type": "string",
                      "example": "abc1234"
                    },
                    "time": {
                      "type": "string",
                      "example": "2026-10-07T10:00:00.000Z"
                    }
                  },
                  "required": [
                    "status",
                    "environment",
                    "version",
                    "gitSha",
                    "time"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR: Unexpected error, please try again",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message_ar": {
                      "type": "string"
                    },
                    "message_en": {
                      "type": "string"
                    },
                    "details": {
                      "type": "object",
                      "properties": {
                        "fields": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message_ar",
                    "message_en",
                    "request_id"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Who the verified access token says you are",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The signed-in user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "userId": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "user",
                        "admin"
                      ]
                    }
                  },
                  "required": [
                    "userId",
                    "role"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED: Sign-in required or session expired",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message_ar": {
                      "type": "string"
                    },
                    "message_en": {
                      "type": "string"
                    },
                    "details": {
                      "type": "object",
                      "properties": {
                        "fields": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message_ar",
                    "message_en",
                    "request_id"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR: Unexpected error, please try again",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message_ar": {
                      "type": "string"
                    },
                    "message_en": {
                      "type": "string"
                    },
                    "details": {
                      "type": "object",
                      "properties": {
                        "fields": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message_ar",
                    "message_en",
                    "request_id"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/debug/error": {
      "get": {
        "tags": [
          "debug"
        ],
        "summary": "Throws a test error (only mounted outside production)",
        "responses": {
          "200": {
            "description": "Never returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {}
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED: Too many requests, retry later",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message_ar": {
                      "type": "string"
                    },
                    "message_en": {
                      "type": "string"
                    },
                    "details": {
                      "type": "object",
                      "properties": {
                        "fields": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message_ar",
                    "message_en",
                    "request_id"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR: Unexpected error, please try again",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message_ar": {
                      "type": "string"
                    },
                    "message_en": {
                      "type": "string"
                    },
                    "details": {
                      "type": "object",
                      "properties": {
                        "fields": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message_ar",
                    "message_en",
                    "request_id"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
