        {
          "name": "Who the verified access token says you are",
          "request": {
            "name": "Who the verified access token says you are",
            "description": {},
            "url": {
              "path": [
                "api",
                "me"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"response has the documented fields\", () => {",
                  "  const body = pm.response.json();",
                  "  for (const key of [\"userId\",\"role\"]) pm.expect(body).to.have.property(key);",
                  "});"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
      ],
      "event": []
    },
