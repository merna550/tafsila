# Used by `docker compose --profile app`. Copy to .env.docker (git-ignored).
# Same variable names as .env.example (validated by packages/config/env.ts); only hosts differ.
APP_ENV=local
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=<from `supabase status`>
SUPABASE_SERVICE_ROLE_KEY=<from `supabase status`>
DATABASE_URL=postgresql://api_app:api_app_local_only@host.docker.internal:54322/postgres
AI_PROVIDER=anthropic
AI_MODEL_ANALYZE=<cheap model for local>
AI_API_KEY=<your dev key>
PAYMOB_MODE=sandbox
INNGEST_BASE_URL=http://inngest:8288
SIM_SERVICE_URL=http://sim:8000

# Show the Google sign-in button (needs the provider enabled in Supabase).
# AUTH_GOOGLE_ENABLED=false

PHONE_HASH_SECRET=local-dev-phone-hash-secret-0123456789abcdef
