{
  "threshold": 1,
  "minTokens": 50,
  "minLines": 5,
  "reporters": ["console", "markdown"],
  "output": "reports/jscpd",
  "format": ["typescript", "tsx", "javascript"],
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.gen.ts",
    "postman/**",
    "supabase/**"
  ],
  "absolute": true,
  "gitignore": true
}
