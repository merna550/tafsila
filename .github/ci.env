# Non-secret placeholder config so the CI smoke test can boot the image.
# /api/health is a liveness check and must not call external services.
APP_ENV=ci
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=ci-placeholder
SUPABASE_SERVICE_ROLE_KEY=ci-placeholder
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
AI_PROVIDER=anthropic
AI_MODEL_ANALYZE=ci-placeholder
AI_API_KEY=ci-placeholder
PAYMOB_MODE=sandbox
