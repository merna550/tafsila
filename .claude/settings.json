{
  "model": "sonnet",
  "permissions": {
    "deny": [
      "Bash(gh workflow run *deploy*)",
      "Bash(gh workflow run *prod*)",
      "Bash(gh api *dispatches*)",
      "Bash(gh release create*)",
      "Bash(*vercel*--prod*)",
      "Bash(*vercel*promote*)",
      "Bash(*vercel*rollback*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent-setup.sh\"",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/format-changed.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/verify-affected.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
