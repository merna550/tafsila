{
  "name": "tafsila",
  "private": true,
  "description": "Tafsila (تفصيلة): photo-to-sewing-pattern web app",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.22.2 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:all": "supabase start && docker compose up -d && turbo run dev",
    "dev:stop": "docker compose down && supabase stop",
    "build": "turbo run build",
    "test": "turbo run test && pnpm test:docs",
    "test:docs": "vitest run scripts",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "jscpd": "jscpd .",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm jscpd && pnpm depcruise && pnpm docs:check",
    "docs:check": "node scripts/check-handbook.mjs",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/api/src/adapters/supabase/database.gen.ts",
    "docker:build": "docker build -f apps/web/Dockerfile -t tafsila-web:local .",
    "labels:sync": "bash scripts/setup-labels.sh",
    "test-cases:index": "bash scripts/test-case-index.sh",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs}": [
      "prettier --write",
      "eslint --max-warnings 0"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9",
    "supabase": "^2.120.0",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  }
}
